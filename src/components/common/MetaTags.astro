---
import { getImage } from "astro:assets";

import { SITE } from "~/config.mjs";
import type { MetaSEO } from "~/types";
import { getCanonical, getAsset } from "~/utils/permalinks";
import { getRelativeUrlByFilePath } from "~/utils/directories";

import CustomStyles from "~/components/CustomStyles.astro";
import StructuredData, { type BreadcrumbItem } from "~/components/common/StructuredData.astro";

export interface Props extends MetaSEO {
  dontUseTitleTemplate?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const defaultImage = SITE.defaultImage
  ? (
      await getImage({
        src: SITE.defaultImage,
        width: 1200,
        height: 628,
      })
    ).src
  : "";

const {
  title = SITE.name,
  description = "",
  image: _image = defaultImage,

  canonical = getCanonical(String(Astro.url.pathname)),
  noindex = false,
  nofollow = false,

  ogTitle = title,
  ogType = "website",

  dontUseTitleTemplate = false,
} = Astro.props;

const image =
  typeof _image === "string"
    ? new URL(_image, Astro.site)
    : _image && typeof _image["src"] !== "undefined"
      ? // @ts-ignore
        new URL(getRelativeUrlByFilePath(_image.src), Astro.site)
      : null;

const googleAnalyticsScript = `window.dataLayer = window.dataLayer || [];
function gtag() { window.dataLayer.push(arguments); }
gtag("js", new Date());
gtag("config", ${JSON.stringify(SITE.googleAnalyticsId)});`;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{dontUseTitleTemplate ? title : `${title} — ${SITE.name}`}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={String(canonical)} />
<link rel="sitemap" href={getAsset("/sitemap-index.xml")} />
{
  (noindex || nofollow) && (
    <meta name="robots" content={[noindex && "noindex", nofollow && "nofollow"].filter(Boolean).join(", ")} />
  )
}

<!-- Open Graph -->
<meta property="og:url" content={String(canonical)} />
<meta property="og:title" content={ogTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
{image && <meta property="og:image" content={image.toString()} />}
{image && <meta property="og:image:alt" content={ogTitle} />}

<!-- Twitter -->
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<meta name="twitter:creator" content="@theroks" />
<meta name="twitter:title" content={ogTitle} />
{description && <meta name="twitter:description" content={description} />}
{image && <meta name="twitter:image" content={image.toString()} />}
{image && <meta name="twitter:image:alt" content={ogTitle} />}

<CustomStyles />

<!-- Structured Data (JSON-LD) -->
<StructuredData
  type={ogType === "article" ? "blog-posting" : "website"}
  post={Astro.props.post}
  breadcrumbs={Astro.props.breadcrumbs}
/>

<!-- Google Site Verification -->
{SITE.googleSiteVerificationId && <meta name="google-site-verification" content={SITE.googleSiteVerificationId} />}

<!-- Google Analytics -->
{
  SITE.googleAnalyticsId && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${SITE.googleAnalyticsId}`}
        type="text/partytown"
      />
      <script is:inline type="text/partytown" set:html={googleAnalyticsScript} />
    </>
  )
}

<!-- {SITE.splitbeeAnalytics?.enabled && <SplitbeeAnalytics {...SITE.splitbeeAnalytics} />} -->

<link rel="shortcut icon" href={getAsset("/icon.png")} />
<link rel="icon" type="image/svg+xml" href={getAsset("/icon.png")} />
<link rel="mask-icon" href={getAsset("/icon.png")} color="#8D46E7" />
<script
  is:inline
  defer
  src="https://static.cloudflareinsights.com/beacon.min.js"
  data-cf-beacon='{"token": "3a97b7004e184fb3864600759db69a73"}'></script>
