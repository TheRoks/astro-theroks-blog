---
import { Picture } from "astro:assets";

import { BLOG } from "~/config.mjs";
import type { Post } from "~/types";

import { findImage } from "~/utils/images";
import { getPermalink } from "~/utils/permalinks";

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = typeof post.image === "string" ? await findImage(post.image) : post.image;
---

<article class="mb-6 transition">
  <div class="relative md:h-64 bg-gray-400 dark:bg-slate-700 rounded shadow-lg mb-6">
    {
      image && (
        <a href={getPermalink(post.permalink, "post")}>
          {typeof image === "string" ? (
            <Picture
              src={image}
              width={1200}
              height={675}
              class="md:object-cover w-full md:w-auto md:h-full rounded shadow-lg bg-gray-400 dark:bg-slate-700"
              alt={post.title}
              pictureAttributes={{}}
            />
          ) : (
            <Picture
              src={image}
              class="md:object-cover w-full md:w-auto md:h-full rounded shadow-lg bg-gray-400 dark:bg-slate-700"
              alt={post.title}
              inferSize
              pictureAttributes={{}}
            />
          )}
        </a>
      )
    }
  </div>
  <h3 class="mb-2 text-xl font-bold leading-tight sm:text-2xl font-heading">
    {
      BLOG?.post?.disabled ? (
        post.title
      ) : (
        <a
          href={getPermalink(post.permalink, "post")}
          class="hover:text-primary dark:hover:text-blue-700  transition ease-in duration-200"
        >
          {post.title}
        </a>
      )
    }
  </h3>
  <p class="text-muted dark:text-slate-400 text-lg">{post.excerpt || post.description}</p>
</article>
