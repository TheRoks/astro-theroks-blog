---
import { Icon } from "astro-icon/components";

import { SITE } from "~/config.mjs";
import Layout from "~/layouts/PageLayout.astro";
import { fetchPosts } from "~/utils/blog";
import { getBlogPermalink, getPermalink } from "~/utils/permalinks";
import { getFormattedDate } from "~/utils/utils";

const meta = {
  title: SITE.title,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const allPosts = await fetchPosts();
const [featuredPost, ...recentPosts] = allPosts.slice(0, 5);

const topics = [
  { label: "Sitecore", tag: "sitecore" },
  { label: ".NET & C#", tag: "dotnet" },
  { label: "Architecture", tag: "architecture" },
  { label: "Workflow", tag: "workflow" },
  { label: "DevOps", tag: "devops" },
];
---

<Layout {meta}>
  <div>
    <section class="relative isolate overflow-hidden border-b border-gray-200 dark:border-slate-800">
      <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-32 right-[-10rem] h-96 w-96 rounded-full bg-primary/10 blur-3xl dark:bg-blue-500/10">
        </div>
        <div
          class="absolute bottom-[-12rem] left-[-8rem] h-80 w-80 rounded-full bg-cyan-400/10 blur-3xl dark:bg-cyan-500/5"
        >
        </div>
        <div
          class="absolute inset-0 bg-[linear-gradient(to_right,rgba(148,163,184,0.08)_1px,transparent_1px),linear-gradient(to_bottom,rgba(148,163,184,0.08)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:linear-gradient(to_bottom,black,transparent)]"
        >
        </div>
      </div>
      <div
        class="mx-auto grid max-w-screen-xl gap-12 px-6 py-16 sm:px-8 sm:py-20 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end lg:gap-16 lg:px-10 lg:py-28"
      >
        <div class="max-w-3xl">
          <p class="mb-5 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-primary">
            <span
              class="h-2 w-2 rounded-full bg-primary shadow-[0_0_0_5px_color-mix(in_srgb,var(--aw-color-primary)_15%,transparent)]"
            ></span>
            Engineering notes by Stefan Roks
          </p>
          <h1
            class="max-w-3xl font-heading text-5xl font-bold leading-[0.98] tracking-[-0.04em] text-gray-900 dark:text-white sm:text-6xl lg:text-7xl"
          >
            Practical ideas for <span class="text-primary">building better software.</span>
          </h1>
          <p class="mt-7 max-w-2xl text-xl leading-8 text-muted dark:text-slate-300 sm:text-2xl sm:leading-9">
            Clear, implementation-focused notes on Sitecore, .NET, frontend architecture, developer workflow, and
            DevOps.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a class="btn btn-primary" href="#latest-notes">
              Read the latest notes
              <Icon name="tabler:arrow-down" class="ml-2 h-5 w-5" />
            </a>
            <a class="btn" href="/topics">
              Explore topics
              <Icon name="tabler:arrow-up-right" class="ml-2 h-5 w-5" />
            </a>
          </div>
        </div>

        <aside
          class="relative overflow-hidden rounded-3xl border border-gray-200/80 bg-white/70 p-6 shadow-xl shadow-slate-900/5 backdrop-blur dark:border-slate-700/80 dark:bg-slate-800/70 dark:shadow-black/10 sm:p-7"
          aria-label="About this blog"
        >
          <div
            class="absolute right-0 top-0 h-24 w-24 translate-x-8 -translate-y-8 rounded-full bg-primary/15 blur-2xl"
            aria-hidden="true"
          >
          </div>
          <div class="relative">
            <div
              class="mb-10 flex items-center justify-between text-sm font-semibold uppercase tracking-[0.16em] text-muted dark:text-slate-400"
            >
              <span>Field notes</span>
              <Icon name="tabler:terminal-2" class="h-5 w-5 text-primary" />
            </div>
            <div class="grid grid-cols-2 gap-6">
              <div>
                <p class="font-heading text-3xl font-bold text-gray-900 dark:text-white">{allPosts.length}</p>
                <p class="mt-1 text-sm text-muted dark:text-slate-400">published notes</p>
              </div>
              <div>
                <p class="font-heading text-3xl font-bold text-gray-900 dark:text-white">{topics.length}</p>
                <p class="mt-1 text-sm text-muted dark:text-slate-400">focus areas</p>
              </div>
            </div>
            <div class="mt-8 border-t border-gray-200 pt-5 dark:border-slate-700">
              <p class="text-sm leading-6 text-muted dark:text-slate-400">
                Long-form notes, patterns, and lessons learned from building software in the real world.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section id="latest-notes" class="mx-auto max-w-screen-xl px-6 py-16 sm:px-8 sm:py-20 lg:px-10 lg:py-24">
      <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-primary">From the notebook</p>
          <h2 class="font-heading text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
            Latest notes
          </h2>
        </div>
        <a class="group inline-flex items-center font-semibold text-primary hover:underline" href={getBlogPermalink()}>
          View all articles
          <Icon
            name="tabler:arrow-up-right"
            class="ml-1.5 h-5 w-5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
      </div>

      {
        featuredPost && (
          <article class="group relative mb-8 overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-xl shadow-slate-900/5 transition duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-slate-900/10 dark:border-slate-700 dark:bg-slate-800 dark:shadow-black/10 dark:hover:shadow-black/20">
            <div class="grid lg:grid-cols-[0.9fr_1.1fr]">
              <div class="relative min-h-64 overflow-hidden bg-slate-950 p-7 text-white sm:p-10 lg:min-h-full">
                <div class="absolute inset-0 opacity-60" aria-hidden="true">
                  <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full border-[32px] border-primary/40" />
                  <div class="absolute -bottom-24 -left-20 h-72 w-72 rounded-full border-[48px] border-cyan-400/20" />
                  <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-primary/20 to-transparent" />
                </div>
                <div class="relative flex h-full min-h-48 flex-col justify-between">
                  <div class="flex items-center justify-between text-sm font-semibold uppercase tracking-[0.18em] text-slate-300">
                    <span>Featured note</span>
                    <span class="font-mono text-primary">01</span>
                  </div>
                  <div class="mt-12">
                    <p class="font-mono text-sm text-cyan-300">/dev/notes/latest</p>
                    <p class="mt-3 max-w-xs font-heading text-3xl font-bold leading-tight sm:text-4xl">
                      Build with context. Ship with confidence.
                    </p>
                  </div>
                </div>
              </div>
              <div class="flex flex-col justify-center p-7 sm:p-10 lg:p-12">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted dark:text-slate-400">
                  <time datetime={featuredPost.publishDate.toISOString()}>
                    {getFormattedDate(featuredPost.publishDate)}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span>Latest publication</span>
                </div>
                <h3 class="mt-5 font-heading text-3xl font-bold leading-tight tracking-tight text-gray-900 dark:text-white sm:text-4xl">
                  <a class="transition-colors hover:text-primary" href={getPermalink(featuredPost.permalink, "post")}>
                    {featuredPost.title}
                  </a>
                </h3>
                <p class="mt-5 text-lg leading-8 text-muted dark:text-slate-300">
                  {featuredPost.excerpt || featuredPost.description}
                </p>
                <a
                  class="relative mt-7 inline-flex items-center gap-2 font-semibold text-primary hover:underline"
                  href={getPermalink(featuredPost.permalink, "post")}
                >
                  Read the article
                  <Icon name="tabler:arrow-right" class="h-5 w-5 transition-transform group-hover:translate-x-1" />
                </a>
              </div>
            </div>
          </article>
        )
      }

      <ul class="grid gap-5 md:grid-cols-2">
        {
          recentPosts.map((post, index) => (
            <li>
              <article class="group flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg hover:shadow-slate-900/5 dark:border-slate-700 dark:bg-slate-800 dark:hover:border-blue-400/50 dark:hover:shadow-black/20 sm:p-7">
                <div class="flex items-center justify-between gap-4 text-sm text-muted dark:text-slate-400">
                  <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
                  <span class="font-mono text-xs text-primary/70">0{index + 2}</span>
                </div>
                <h3 class="mt-5 font-heading text-2xl font-bold leading-tight tracking-tight text-gray-900 dark:text-white">
                  <a class="transition-colors group-hover:text-primary" href={getPermalink(post.permalink, "post")}>
                    {post.title}
                  </a>
                </h3>
                <p class="mt-4 flex-grow text-lg leading-7 text-muted dark:text-slate-300">
                  {post.excerpt || post.description}
                </p>
                <a
                  class="mt-6 inline-flex items-center font-semibold text-primary hover:underline"
                  href={getPermalink(post.permalink, "post")}
                >
                  Read note
                  <Icon name="tabler:arrow-right" class="ml-2 h-5 w-5 transition-transform group-hover:translate-x-1" />
                </a>
              </article>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="border-y border-gray-200 bg-gray-50/80 dark:border-slate-800 dark:bg-slate-800/30">
      <div
        class="mx-auto flex max-w-screen-xl flex-col gap-6 px-6 py-10 sm:px-8 sm:py-12 lg:flex-row lg:items-center lg:justify-between lg:px-10"
      >
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">Explore by focus</p>
          <h2 class="mt-2 font-heading text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
            Find your next rabbit hole.
          </h2>
        </div>
        <nav class="flex flex-wrap gap-2" aria-label="Explore topics">
          {
            topics.map((topic) => (
              <a
                class="rounded-full border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 transition hover:border-primary hover:text-primary dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:border-blue-400 dark:hover:text-blue-300"
                href={getPermalink(topic.tag, "tag")}
              >
                {topic.label}
              </a>
            ))
          }
          <a
            class="rounded-full border border-primary/30 bg-primary/10 px-4 py-2 text-sm font-semibold text-primary transition hover:border-primary hover:bg-primary/20"
            href="/topics">All topics <span aria-hidden="true">→</span></a
          >
        </nav>
      </div>
    </section>
  </div>
</Layout>
