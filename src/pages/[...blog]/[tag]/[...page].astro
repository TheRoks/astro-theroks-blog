---
import { SITE, BLOG } from "~/config.mjs";

import Layout from "~/layouts/PageLayout.astro";
import BlogList from "~/components/blog/List.astro";
import Pagination from "~/components/common/Pagination.astro";

import { fetchPosts } from "~/utils/blog";
import { TAG_BASE, getBlogPermalink } from "~/utils/permalinks";
import type { BreadcrumbItem } from "~/components/common/StructuredData.astro";
import type { GetStaticPaths } from "astro";
import type { MetaSEO } from "~/types";

export const getStaticPaths = (async ({ paginate }) => {
  if (BLOG?.disabled || BLOG?.tag?.disabled) return [];

  const posts = await fetchPosts();
  const tags = new Set<string>();
  posts.map((post) => {
    Array.isArray(post.tags) && post.tags.map((tag) => tags.add(tag.toLowerCase()));
  });

  return Array.from(tags).flatMap((tag: string) =>
    paginate(
      posts.filter((post) => Array.isArray(post.tags) && post.tags.find((elem) => elem.toLowerCase() === tag)),
      {
        params: { tag: tag, blog: TAG_BASE || undefined },
        pageSize: BLOG.postsPerPage,
        props: { tag },
      }
    )
  );
}) satisfies GetStaticPaths;

const { page, tag } = Astro.props;

const currentPage = page.currentPage ?? 1;

// Create breadcrumbs: Home > Blog > Tag: {tagName}
const breadcrumbs: BreadcrumbItem[] = [
  {
    name: "Home",
    url: new URL("/", SITE.origin).toString(),
  },
  {
    name: "Blog",
    url: new URL(getBlogPermalink(), SITE.origin).toString(),
  },
  {
    name: `Tag: ${tag}`,
    url: new URL(Astro.url.pathname, SITE.origin).toString(),
  },
];

const meta: MetaSEO = {
  title: `Posts by tag '${tag}'${currentPage > 1 ? ` — Page ${currentPage} ` : ""}`,
  description: SITE.description,
  noindex: BLOG?.tag?.noindex,
  breadcrumbs: breadcrumbs,
};
---

<Layout meta={meta}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-3xl">
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>
