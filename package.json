{
  "name": "@onwidget/astrowind",
  "description": "A template to make your website using Astro + Tailwind CSS.",
  "version": "0.9.8",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "content:check": "node scripts/content-audit.mjs",
    "build": "pnpm content:check && astro build && pnpm generate:markdown && pnpm generate:redirects",
    "generate:markdown": "node scripts/generate-markdown.mjs dist",
    "generate:redirects": "node scripts/generate-redirects.mjs dist/_redirects",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "lint": "eslint .",
    "lint:eslint": "eslint .",
    "typecheck": "astro check"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/mdx": "8.1.3",
    "@astrojs/partytown": "2.1.9",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@iconify-json/logos": "1.2.19",
    "@iconify-json/tabler": "1.2.43",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.7",
    "astro-compress": "2.4.3",
    "astro-icon": "1.2.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "limax": "4.2.3",
    "mdast-util-to-string": "4.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-external-links": "3.0.0",
    "rehype-slug": "6.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
