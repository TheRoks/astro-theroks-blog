{
  "name": "@onwidget/astrowind",
  "description": "A template to make your website using Astro + Tailwind CSS.",
  "version": "0.9.8",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "content:check": "node scripts/content-audit.mjs",
    "build": "pnpm content:check && astro build && pnpm generate:markdown && pnpm generate:redirects",
    "generate:markdown": "node scripts/generate-markdown.mjs dist",
    "generate:redirects": "node scripts/generate-redirects.mjs dist/_redirects",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "lint": "eslint .",
    "lint:eslint": "eslint .",
    "typecheck": "astro check"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/partytown": "2.1.7",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@iconify-json/logos": "1.2.14",
    "@iconify-json/tabler": "1.2.38",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "astro-compress": "2.4.3",
    "astro-icon": "1.2.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.12.0",
    "limax": "4.2.3",
    "mdast-util-to-string": "4.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-external-links": "3.0.0",
    "rehype-slug": "6.0.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
